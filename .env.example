# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Archive RPC for validation (e.g. Alchemy: https://eth-mainnet.g.alchemy.com/v2/<key>)
ETH_RPC_URL=

# Your Google Cloud project for BigQuery (the sandbox is fine)
GCP_PROJECT=your-gcp-project

# Where raw and processed parquet files go (default: ./data)
# DATA_DIR=
